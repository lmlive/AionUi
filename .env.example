# AionUi Docker Compose — environment variable overrides
# Copy this file to .env and customize before running: docker compose up

# Host port for the FastAPI PDF/skill-management service
API_PORT=8765

# Host port for the web UI (Bun/Node main server + React frontend)
WEBUI_PORT=3000

# CORS allowed origins for the FastAPI service.
# Use "*" to allow all origins (convenient for local testing).
# In production, restrict to your domain, e.g.:
#   ALLOW_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOW_ORIGINS=*
